{
  "name": "claude-buddy",
  "version": "0.4.1",
  "description": "A macOS desktop AI agent that uses the Claude Code CLI as its runtime",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test",
    "runner": "node runner.js",
    "doctor": "node runner.js --doctor",
    "pack": "electron-builder --mac --arm64",
    "pack:all": "electron-builder --mac --arm64 --x64",
    "icon": "python3 tools/make-icon.py"
  },
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "electron",
    "ai-agent",
    "desktop",
    "macos",
    "mcp",
    "stream-json"
  ],
  "homepage": "https://github.com/SingleTime/claude-buddy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SingleTime/claude-buddy.git"
  },
  "bugs": {
    "url": "https://github.com/SingleTime/claude-buddy/issues"
  },
  "author": "FW (SingleTime)",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {},
  "build": {
    "appId": "com.claudebuddy.app",
    "productName": "Claude Buddy",
    "artifactName": "Claude-Buddy-${version}-${arch}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "runner.js",
      "lib/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runner.js",
        "to": "runner.js"
      },
      {
        "from": "lib",
        "to": "lib"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    }
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  }
}
